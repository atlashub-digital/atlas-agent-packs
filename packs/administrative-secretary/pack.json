{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "id": "PACK-003",
  "slug": "administrative-secretary",
  "version": "0.2.0",
  "status": "demo",
  "name": "Secretária Administrativa",
  "summary": "Colaborador digital gerido pela AtlasHub: pedido de reunião, email financeiro. Demonstração com dados fictícios; funcional em staging com sistemas sandbox.",
  "locale": "pt-PT",
  "owner": "atlashub",
  "segments": [
    "transversal"
  ],
  "equation": [
    "custos",
    "velocidade"
  ],
  "channels": [
    "email",
    "interno"
  ],
  "commercial": {
    "cloud": true,
    "onsite": true
  },
  "steps": [
    {
      "id": "trigger",
      "label": "Pedido",
      "description": "Entrada assinada pelo canal do cliente"
    },
    {
      "id": "interpret",
      "label": "Interpretar",
      "description": "Intenção por regras (pt/en/es); IA opcional só quando as regras não reconhecem"
    },
    {
      "id": "act",
      "label": "Executar",
      "description": "Ferramentas autorizadas no sistema do cliente"
    },
    {
      "id": "human",
      "label": "Supervisão humana",
      "description": "Aprovação ou passagem para uma pessoa"
    },
    {
      "id": "done",
      "label": "Concluir",
      "description": "Resultado auditado e medido"
    }
  ],
  "runtime": {
    "agent": "atlashub-role-engine",
    "skills": [
      "skills/agent.md"
    ],
    "workflows": [
      "workflows/README.md"
    ]
  },
  "tools": [
    {
      "id": "mail.read",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/administrative-secretary/mail-read",
        "demo": "mock:mail.read"
      }
    },
    {
      "id": "mail.label",
      "description": "Altera o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/administrative-secretary/mail-label",
        "demo": "mock:mail.label"
      }
    },
    {
      "id": "mail.draft_reply",
      "description": "Altera o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/administrative-secretary/mail-draft_reply",
        "demo": "mock:mail.draft_reply"
      }
    },
    {
      "id": "calendar.find_slots",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/administrative-secretary/calendar-find_slots",
        "demo": "mock:calendar.find_slots"
      }
    },
    {
      "id": "calendar.hold",
      "description": "Altera o sistema do cliente (exige aprovação humana).",
      "policy": "approval",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/administrative-secretary/calendar-hold",
        "demo": "mock:calendar.hold"
      }
    },
    {
      "id": "brief.create",
      "description": "Altera o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/administrative-secretary/brief-create",
        "demo": "mock:brief.create"
      }
    },
    {
      "id": "team.handoff",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/administrative-secretary/team-handoff",
        "demo": "mock:team.handoff"
      }
    }
  ],
  "integrations": [
    {
      "id": "mailbox",
      "kind": "email",
      "required": true,
      "description": "Caixa de correio (leitura, etiquetas, rascunhos)"
    },
    {
      "id": "calendar",
      "kind": "calendar",
      "required": true,
      "description": "Agenda da equipa"
    }
  ],
  "config": [
    {
      "key": "business_name",
      "type": "string",
      "required": true
    },
    {
      "key": "handoff_queue",
      "type": "string",
      "required": true
    },
    {
      "key": "locale",
      "type": "string",
      "required": false
    }
  ],
  "guardrails": [
    {
      "id": "human-approval",
      "rule": "Nunca enviar mensagens, publicar ou assumir compromissos sem aprovação humana.",
      "action": "handoff"
    },
    {
      "id": "consent",
      "rule": "Nenhuma comunicação sem consentimento registado.",
      "action": "block"
    },
    {
      "id": "draft-only",
      "rule": "O envio de email está proibido: só rascunhos.",
      "action": "block"
    },
    {
      "id": "forbidden-tools",
      "rule": "Ações proibidas a este colaborador: mail.send.",
      "action": "block"
    }
  ],
  "metrics": {
    "inputs": [
      {
        "key": "volume_per_month",
        "label": "Pedidos por mês",
        "unit": "",
        "default": 300,
        "min": 0,
        "max": 100000,
        "step": 10
      },
      {
        "key": "minutes_per_task",
        "label": "Minutos por pedido hoje",
        "unit": "min",
        "default": 6,
        "min": 1,
        "max": 120,
        "step": 1
      },
      {
        "key": "automatable_pct",
        "label": "Pedidos tratados sem intervenção",
        "unit": "%",
        "default": 60,
        "min": 0,
        "max": 100,
        "step": 5
      }
    ],
    "outputs": [
      {
        "key": "hours_saved",
        "label": "Horas de equipa libertadas por mês",
        "unit": "h",
        "formula": "round(volume_per_month * minutes_per_task * automatable_pct / 100 / 60)"
      }
    ],
    "disclaimer": "Hipótese calculada com os números indicados. Não é uma previsão nem um resultado garantido."
  },
  "demo": {
    "fixtures": "demo/fixtures/example.json",
    "mocks": "demo/mocks.json",
    "scenarios": [
      "demo/scenarios/01-meeting-request.json",
      "demo/scenarios/02-finance-email.json"
    ],
    "labels": {
      "header": "Escritório Fictício · Demo",
      "agent": "SECRETÁRIA ADMINISTRATIVA · DEMO",
      "customer": "PESSOA FICTÍCIA"
    }
  },
  "tests": "tests/acceptance.json",
  "compliance": {
    "dataClasses": [
      "contacto",
      "correspondência"
    ],
    "excludes": [
      "dados sensíveis",
      "credenciais",
      "dados reais em demonstração"
    ],
    "lgpd": [
      "Consentimento e base legal antes de tratar dados",
      "Minimização e retenção definidas por contrato"
    ]
  },
  "clara": {
    "intro": [
      "Sou a Clara. A AtlasHub opera e supervisiona o Secretária Administrativa como serviço gerido.",
      "Demonstração com dados fictícios; nenhuma ação real é executada."
    ],
    "allDone": "Solicite um assessment para definir âmbito, integrações e limites. Este colaborador está em demonstração, ainda não em piloto.",
    "context": [
      {
        "label": "Segmento",
        "value": "transversal"
      },
      {
        "label": "Ações com aprovação",
        "value": "calendar.hold"
      }
    ]
  }
}
