{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "id": "PACK-005",
  "slug": "ecommerce-assistant",
  "version": "0.1.0",
  "status": "demo",
  "name": "Assistente E-commerce",
  "summary": "Colaborador digital gerido pela AtlasHub: estado da encomenda, pedido de reembolso. Demonstração com dados fictícios; funcional em staging com sistemas sandbox.",
  "locale": "pt-PT",
  "owner": "atlashub",
  "segments": [
    "comercio"
  ],
  "equation": [
    "custos",
    "velocidade"
  ],
  "channels": [
    "webchat",
    "whatsapp",
    "email"
  ],
  "commercial": {
    "cloud": true,
    "onsite": true
  },
  "steps": [
    {
      "id": "trigger",
      "label": "Pedido",
      "description": "Entrada assinada pelo canal do cliente"
    },
    {
      "id": "interpret",
      "label": "Interpretar",
      "description": "Intenção por regras (pt/en/es); IA opcional só quando as regras não reconhecem"
    },
    {
      "id": "act",
      "label": "Executar",
      "description": "Ferramentas autorizadas no sistema do cliente"
    },
    {
      "id": "human",
      "label": "Supervisão humana",
      "description": "Aprovação ou passagem para uma pessoa"
    },
    {
      "id": "done",
      "label": "Concluir",
      "description": "Resultado auditado e medido"
    }
  ],
  "runtime": {
    "agent": "atlashub-role-engine",
    "skills": [
      "skills/agent.md"
    ],
    "workflows": [
      "workflows/README.md"
    ]
  },
  "tools": [
    {
      "id": "order.lookup",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/ecommerce-assistant/order-lookup",
        "demo": "mock:order.lookup"
      }
    },
    {
      "id": "faq.answer",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/ecommerce-assistant/faq-answer",
        "demo": "mock:faq.answer"
      }
    },
    {
      "id": "return.create",
      "description": "Altera o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/ecommerce-assistant/return-create",
        "demo": "mock:return.create"
      }
    },
    {
      "id": "refund.request",
      "description": "Altera o sistema do cliente (exige aprovação humana).",
      "policy": "approval",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/ecommerce-assistant/refund-request",
        "demo": "mock:refund.request"
      }
    },
    {
      "id": "team.handoff",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/ecommerce-assistant/team-handoff",
        "demo": "mock:team.handoff"
      }
    }
  ],
  "integrations": [
    {
      "id": "store",
      "kind": "ecommerce",
      "required": true,
      "description": "Loja / ERP (encomendas, devoluções)"
    },
    {
      "id": "faq",
      "kind": "knowledge",
      "required": true,
      "description": "Políticas de envio e devolução"
    }
  ],
  "config": [
    {
      "key": "business_name",
      "type": "string",
      "required": true
    },
    {
      "key": "handoff_queue",
      "type": "string",
      "required": true
    },
    {
      "key": "locale",
      "type": "string",
      "required": false
    }
  ],
  "guardrails": [
    {
      "id": "verify-identity",
      "rule": "Nenhum dado de encomenda antes de verificar número + email.",
      "action": "block"
    },
    {
      "id": "human-approval",
      "rule": "Reembolsos só com aprovação humana; o assistente nunca movimenta dinheiro.",
      "action": "handoff"
    },
    {
      "id": "forbidden-tools",
      "rule": "Ações proibidas a este colaborador: payment.refund_execute.",
      "action": "block"
    }
  ],
  "metrics": {
    "inputs": [
      {
        "key": "volume_per_month",
        "label": "Pedidos por mês",
        "unit": "",
        "default": 300,
        "min": 0,
        "max": 100000,
        "step": 10
      },
      {
        "key": "minutes_per_task",
        "label": "Minutos por pedido hoje",
        "unit": "min",
        "default": 6,
        "min": 1,
        "max": 120,
        "step": 1
      },
      {
        "key": "automatable_pct",
        "label": "Pedidos tratados sem intervenção",
        "unit": "%",
        "default": 60,
        "min": 0,
        "max": 100,
        "step": 5
      }
    ],
    "outputs": [
      {
        "key": "hours_saved",
        "label": "Horas de equipa libertadas por mês",
        "unit": "h",
        "formula": "round(volume_per_month * minutes_per_task * automatable_pct / 100 / 60)"
      }
    ],
    "disclaimer": "Hipótese calculada com os números indicados. Não é uma previsão nem um resultado garantido."
  },
  "demo": {
    "fixtures": "demo/fixtures/example.json",
    "mocks": "demo/mocks.json",
    "scenarios": [
      "demo/scenarios/01-order-status.json",
      "demo/scenarios/02-refund.json"
    ],
    "labels": {
      "header": "Loja Fictícia · Demo",
      "agent": "ASSISTENTE E-COMMERCE · DEMO",
      "customer": "PESSOA FICTÍCIA"
    }
  },
  "tests": "tests/acceptance.json",
  "compliance": {
    "dataClasses": [
      "contacto",
      "encomendas"
    ],
    "excludes": [
      "dados sensíveis",
      "credenciais",
      "dados reais em demonstração"
    ],
    "lgpd": [
      "Consentimento e base legal antes de tratar dados",
      "Minimização e retenção definidas por contrato"
    ]
  },
  "clara": {
    "intro": [
      "Sou a Clara. A AtlasHub opera e supervisiona o Assistente E-commerce como serviço gerido.",
      "Demonstração com dados fictícios; nenhuma ação real é executada."
    ],
    "allDone": "Solicite um assessment para definir âmbito, integrações e limites. Este colaborador está em demonstração, ainda não em piloto.",
    "context": [
      {
        "label": "Segmento",
        "value": "comercio"
      },
      {
        "label": "Ações com aprovação",
        "value": "refund.request"
      }
    ]
  }
}
