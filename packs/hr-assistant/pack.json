{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "id": "PACK-008",
  "slug": "hr-assistant",
  "version": "0.1.0",
  "status": "demo",
  "name": "Assistente de RH",
  "summary": "Colaborador digital gerido pela AtlasHub: candidatura, pedido de ranking. Demonstração com dados fictícios; funcional em staging com sistemas sandbox.",
  "locale": "pt-PT",
  "owner": "atlashub",
  "segments": [
    "transversal"
  ],
  "equation": [
    "custos",
    "velocidade"
  ],
  "channels": [
    "email",
    "webchat"
  ],
  "commercial": {
    "cloud": true,
    "onsite": true
  },
  "steps": [
    {
      "id": "trigger",
      "label": "Pedido",
      "description": "Entrada assinada pelo canal do cliente"
    },
    {
      "id": "interpret",
      "label": "Interpretar",
      "description": "Intenção por regras (pt/en/es); IA opcional só quando as regras não reconhecem"
    },
    {
      "id": "act",
      "label": "Executar",
      "description": "Ferramentas autorizadas no sistema do cliente"
    },
    {
      "id": "human",
      "label": "Supervisão humana",
      "description": "Aprovação ou passagem para uma pessoa"
    },
    {
      "id": "done",
      "label": "Concluir",
      "description": "Resultado auditado e medido"
    }
  ],
  "runtime": {
    "agent": "atlashub-role-engine",
    "skills": [
      "skills/agent.md"
    ],
    "workflows": [
      "workflows/README.md"
    ]
  },
  "tools": [
    {
      "id": "application.register",
      "description": "Altera o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/hr-assistant/application-register",
        "demo": "mock:application.register"
      }
    },
    {
      "id": "faq.answer",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/hr-assistant/faq-answer",
        "demo": "mock:faq.answer"
      }
    },
    {
      "id": "interview.find_slots",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/hr-assistant/interview-find_slots",
        "demo": "mock:interview.find_slots"
      }
    },
    {
      "id": "interview.schedule",
      "description": "Altera o sistema do cliente (exige aprovação humana).",
      "policy": "approval",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/hr-assistant/interview-schedule",
        "demo": "mock:interview.schedule"
      }
    },
    {
      "id": "team.handoff",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/hr-assistant/team-handoff",
        "demo": "mock:team.handoff"
      }
    }
  ],
  "integrations": [
    {
      "id": "ats",
      "kind": "ats",
      "required": true,
      "description": "Sistema de recrutamento"
    },
    {
      "id": "calendar",
      "kind": "calendar",
      "required": true,
      "description": "Agenda de entrevistas"
    }
  ],
  "config": [
    {
      "key": "business_name",
      "type": "string",
      "required": true
    },
    {
      "key": "handoff_queue",
      "type": "string",
      "required": true
    },
    {
      "key": "locale",
      "type": "string",
      "required": false
    }
  ],
  "guardrails": [
    {
      "id": "no-automated-decisions",
      "rule": "Nunca classificar, pontuar, rejeitar ou contratar candidatos.",
      "action": "block"
    },
    {
      "id": "no-sensitive-data",
      "rule": "Atributos sensíveis (idade, género, origem, religião, saúde…) são descartados.",
      "action": "block"
    },
    {
      "id": "human-approval",
      "rule": "Entrevistas só com aprovação humana.",
      "action": "handoff"
    },
    {
      "id": "forbidden-tools",
      "rule": "Ações proibidas a este colaborador: candidate.rank.",
      "action": "block"
    }
  ],
  "metrics": {
    "inputs": [
      {
        "key": "volume_per_month",
        "label": "Pedidos por mês",
        "unit": "",
        "default": 300,
        "min": 0,
        "max": 100000,
        "step": 10
      },
      {
        "key": "minutes_per_task",
        "label": "Minutos por pedido hoje",
        "unit": "min",
        "default": 6,
        "min": 1,
        "max": 120,
        "step": 1
      },
      {
        "key": "automatable_pct",
        "label": "Pedidos tratados sem intervenção",
        "unit": "%",
        "default": 60,
        "min": 0,
        "max": 100,
        "step": 5
      }
    ],
    "outputs": [
      {
        "key": "hours_saved",
        "label": "Horas de equipa libertadas por mês",
        "unit": "h",
        "formula": "round(volume_per_month * minutes_per_task * automatable_pct / 100 / 60)"
      }
    ],
    "disclaimer": "Hipótese calculada com os números indicados. Não é uma previsão nem um resultado garantido."
  },
  "demo": {
    "fixtures": "demo/fixtures/example.json",
    "mocks": "demo/mocks.json",
    "scenarios": [
      "demo/scenarios/01-application.json",
      "demo/scenarios/02-ranking-blocked.json"
    ],
    "labels": {
      "header": "Empresa Fictícia · Demo",
      "agent": "ASSISTENTE DE RH · DEMO",
      "customer": "PESSOA FICTÍCIA"
    }
  },
  "tests": "tests/acceptance.json",
  "compliance": {
    "dataClasses": [
      "candidatura (sem atributos sensíveis)"
    ],
    "excludes": [
      "dados sensíveis",
      "credenciais",
      "dados reais em demonstração"
    ],
    "lgpd": [
      "Consentimento e base legal antes de tratar dados",
      "Minimização e retenção definidas por contrato"
    ]
  },
  "clara": {
    "intro": [
      "Sou a Clara. A AtlasHub opera e supervisiona o Assistente de RH como serviço gerido.",
      "Demonstração com dados fictícios; nenhuma ação real é executada."
    ],
    "allDone": "Solicite um assessment para definir âmbito, integrações e limites. Este colaborador está em demonstração, ainda não em piloto.",
    "context": [
      {
        "label": "Segmento",
        "value": "transversal"
      },
      {
        "label": "Ações com aprovação",
        "value": "interview.schedule"
      }
    ]
  }
}
