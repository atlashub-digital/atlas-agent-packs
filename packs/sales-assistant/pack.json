{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "id": "PACK-002",
  "slug": "sales-assistant",
  "version": "0.2.0",
  "status": "demo",
  "name": "Assistente Comercial",
  "summary": "Colaborador digital gerido pela AtlasHub: lead qualificado, pedido de remoção. Demonstração com dados fictícios; funcional em staging com sistemas sandbox.",
  "locale": "pt-PT",
  "owner": "atlashub",
  "segments": [
    "servicos"
  ],
  "equation": [
    "receita",
    "velocidade"
  ],
  "channels": [
    "email",
    "webchat",
    "whatsapp"
  ],
  "commercial": {
    "cloud": true,
    "onsite": true
  },
  "steps": [
    {
      "id": "trigger",
      "label": "Pedido",
      "description": "Entrada assinada pelo canal do cliente"
    },
    {
      "id": "interpret",
      "label": "Interpretar",
      "description": "Intenção por regras (pt/en/es); IA opcional só quando as regras não reconhecem"
    },
    {
      "id": "act",
      "label": "Executar",
      "description": "Ferramentas autorizadas no sistema do cliente"
    },
    {
      "id": "human",
      "label": "Supervisão humana",
      "description": "Aprovação ou passagem para uma pessoa"
    },
    {
      "id": "done",
      "label": "Concluir",
      "description": "Resultado auditado e medido"
    }
  ],
  "runtime": {
    "agent": "atlashub-role-engine",
    "skills": [
      "skills/agent.md"
    ],
    "workflows": [
      "workflows/README.md"
    ]
  },
  "tools": [
    {
      "id": "crm.upsert_lead",
      "description": "Altera o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/sales-assistant/crm-upsert_lead",
        "demo": "mock:crm.upsert_lead"
      }
    },
    {
      "id": "crm.log_activity",
      "description": "Altera o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/sales-assistant/crm-log_activity",
        "demo": "mock:crm.log_activity"
      }
    },
    {
      "id": "crm.suppress",
      "description": "Altera o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/sales-assistant/crm-suppress",
        "demo": "mock:crm.suppress"
      }
    },
    {
      "id": "calendar.find_slots",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/sales-assistant/calendar-find_slots",
        "demo": "mock:calendar.find_slots"
      }
    },
    {
      "id": "calendar.book_meeting",
      "description": "Altera o sistema do cliente (exige aprovação humana).",
      "policy": "approval",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/sales-assistant/calendar-book_meeting",
        "demo": "mock:calendar.book_meeting"
      }
    },
    {
      "id": "message.send_followup",
      "description": "Altera o sistema do cliente (exige aprovação humana).",
      "policy": "approval",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/sales-assistant/message-send_followup",
        "demo": "mock:message.send_followup"
      }
    },
    {
      "id": "team.handoff",
      "description": "Consulta o sistema do cliente.",
      "policy": "auto",
      "input": {},
      "output": {},
      "binding": {
        "prod": "n8n:/webhook/sales-assistant/team-handoff",
        "demo": "mock:team.handoff"
      }
    }
  ],
  "integrations": [
    {
      "id": "crm",
      "kind": "crm",
      "required": true,
      "description": "CRM do cliente (leads, atividades, supressões)"
    },
    {
      "id": "calendar",
      "kind": "calendar",
      "required": true,
      "description": "Agenda comercial"
    },
    {
      "id": "email",
      "kind": "email",
      "required": false,
      "description": "Envio de follow-ups aprovados"
    }
  ],
  "config": [
    {
      "key": "business_name",
      "type": "string",
      "required": true
    },
    {
      "key": "handoff_queue",
      "type": "string",
      "required": true
    },
    {
      "key": "locale",
      "type": "string",
      "required": false
    }
  ],
  "guardrails": [
    {
      "id": "human-approval",
      "rule": "Nunca enviar mensagens, publicar ou assumir compromissos sem aprovação humana.",
      "action": "handoff"
    },
    {
      "id": "consent",
      "rule": "Nenhuma comunicação sem consentimento registado; pedidos de remoção são imediatos e definitivos.",
      "action": "block"
    }
  ],
  "metrics": {
    "inputs": [
      {
        "key": "volume_per_month",
        "label": "Pedidos por mês",
        "unit": "",
        "default": 300,
        "min": 0,
        "max": 100000,
        "step": 10
      },
      {
        "key": "minutes_per_task",
        "label": "Minutos por pedido hoje",
        "unit": "min",
        "default": 6,
        "min": 1,
        "max": 120,
        "step": 1
      },
      {
        "key": "automatable_pct",
        "label": "Pedidos tratados sem intervenção",
        "unit": "%",
        "default": 60,
        "min": 0,
        "max": 100,
        "step": 5
      }
    ],
    "outputs": [
      {
        "key": "hours_saved",
        "label": "Horas de equipa libertadas por mês",
        "unit": "h",
        "formula": "round(volume_per_month * minutes_per_task * automatable_pct / 100 / 60)"
      }
    ],
    "disclaimer": "Hipótese calculada com os números indicados. Não é uma previsão nem um resultado garantido."
  },
  "demo": {
    "fixtures": "demo/fixtures/example.json",
    "mocks": "demo/mocks.json",
    "scenarios": [
      "demo/scenarios/01-qualified-lead.json",
      "demo/scenarios/02-opt-out.json"
    ],
    "labels": {
      "header": "Agência Fictícia · Demo",
      "agent": "ASSISTENTE COMERCIAL · DEMO",
      "customer": "PESSOA FICTÍCIA"
    }
  },
  "tests": "tests/acceptance.json",
  "compliance": {
    "dataClasses": [
      "contacto",
      "empresa"
    ],
    "excludes": [
      "dados sensíveis",
      "credenciais",
      "dados reais em demonstração"
    ],
    "lgpd": [
      "Consentimento e base legal antes de tratar dados",
      "Minimização e retenção definidas por contrato"
    ]
  },
  "clara": {
    "intro": [
      "Sou a Clara. A AtlasHub opera e supervisiona o Assistente Comercial como serviço gerido.",
      "Demonstração com dados fictícios; nenhuma ação real é executada."
    ],
    "allDone": "Solicite um assessment para definir âmbito, integrações e limites. Este colaborador está em demonstração, ainda não em piloto.",
    "context": [
      {
        "label": "Segmento",
        "value": "servicos"
      },
      {
        "label": "Ações com aprovação",
        "value": "calendar.book_meeting, message.send_followup"
      }
    ]
  }
}
