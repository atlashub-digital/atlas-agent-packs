{
  "$schema": "../../schema/pack.schema.json",
  "schemaVersion": 1,
  "id": "PACK-002",
  "slug": "sales-assistant",
  "version": "0.1.0",
  "status": "demo",
  "name": "Assistente Comercial",
  "summary": "Demonstração com dados fictícios: qualificação de lead e proposta de próximo passo. Serviço gerido pela AtlasHub; sem integração ativa.",
  "locale": "pt-BR",
  "owner": "max",
  "segments": [
    "servicos"
  ],
  "equation": [
    "custos"
  ],
  "channels": [
    "whatsapp"
  ],
  "commercial": {
    "cloud": true,
    "onsite": true
  },
  "steps": [
    {
      "id": "trigger",
      "label": "Pedido",
      "description": "Pedido fictício com consentimento"
    },
    {
      "id": "interpret",
      "label": "Preparar",
      "description": "qualificação de lead e proposta de próximo passo"
    },
    {
      "id": "human",
      "label": "Aprovação humana",
      "description": "Nenhum envio sem aprovação"
    },
    {
      "id": "done",
      "label": "Concluir",
      "description": "Rascunho entregue à equipa"
    }
  ],
  "runtime": {
    "agent": "hermes",
    "skills": [
      "skills/agent.md"
    ],
    "workflows": [
      "workflows/README.md"
    ]
  },
  "tools": [
    {
      "id": "team.handoff",
      "description": "Passa para uma pessoa.",
      "input": {
        "conversation_id": "string",
        "reason": "string"
      },
      "output": {
        "task_id": "string"
      },
      "binding": {
        "prod": "n8n:/webhook/pack-002/handoff",
        "demo": "mock:team.handoff"
      }
    }
  ],
  "integrations": [],
  "config": [],
  "guardrails": [
    {
      "id": "human-approval",
      "rule": "Nunca enviar mensagens, publicar ou assumir compromissos sem aprovação humana.",
      "action": "handoff"
    },
    {
      "id": "consent",
      "rule": "Nenhuma comunicação sem consentimento registado.",
      "action": "block"
    }
  ],
  "metrics": {
    "inputs": [
      {
        "key": "volume_per_month",
        "label": "Pedidos por mês",
        "unit": "",
        "default": 100,
        "min": 0,
        "max": 100000,
        "step": 10
      }
    ],
    "outputs": [
      {
        "key": "volume",
        "label": "Pedidos por mês",
        "formula": "volume_per_month"
      }
    ],
    "disclaimer": "Hipótese calculada com os números do lead. Não é uma previsão."
  },
  "demo": {
    "fixtures": "demo/fixtures/example.json",
    "mocks": "demo/mocks.json",
    "scenarios": [
      "demo/scenarios/01-happy-path.json",
      "demo/scenarios/02-sensitive.json"
    ],
    "labels": {
      "header": "Empresa Fictícia · Demo",
      "agent": "ASSISTENTE · DEMO",
      "customer": "CLIENTE FICTÍCIO"
    }
  },
  "tests": "tests/acceptance.json",
  "compliance": {
    "dataClasses": [
      "contacto"
    ],
    "excludes": [
      "dados sensíveis",
      "credenciais"
    ],
    "lgpd": [
      "Dados fictícios na demonstração; consentimento antes de contacto"
    ]
  },
  "clara": {
    "intro": [
      "Sou a Clara. A AtlasHub opera e supervisiona este serviço gerido.",
      "Demonstração com dados fictícios; nenhuma mensagem é enviada."
    ],
    "allDone": "Solicite um assessment para definir escopo e integrações. Este perfil ainda não é operacional.",
    "context": [
      {
        "label": "Segmento",
        "value": "Serviços"
      },
      {
        "label": "Modo",
        "value": "Demo sem integração ativa"
      }
    ]
  }
}
